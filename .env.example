BOT_TOKEN=123456:ABCDEF
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cargobot
# Comma-separated Telegram user IDs, e.g. 123,456
ADMIN_IDS=

# Optional: work hours / info shown on /start
WORK_HOURS=Пн–Сб 09:00–18:00
INSTRUCTION_TEXT=Пожалуйста, отправьте ваш код клиента (как в накладной).
INSTRUCTION_VIDEO_URL=
# Prefer file_id (no need to store mp4 on server). Get it by forwarding/uploading once and reading file_id from logs/code.
INSTRUCTION_VIDEO_FILE_ID=
# Alternative: local path to mp4 on the server/PC where bot runs
INSTRUCTION_VIDEO_PATH=

# Registration: cargo warehouse address and first auto client number (600-kar, 601-kar, ...)
CARGO_ADDRESS=Бишкек, ул. Примерная 1, склад карго
# Список запрещённых товаров (в «Информация»); для переноса строки используйте \n
PROHIBITED_GOODS=оружие; наркотики; взрывчатые вещества; аккумуляторы без согласования
CLIENT_CODE_START=600
